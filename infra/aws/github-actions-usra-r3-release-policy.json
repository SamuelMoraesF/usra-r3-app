{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteReleaseObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::usra-r3-releases/*/*"
    },
    {
      "Sid": "StartMultipartUploadsOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucketMultipartUploads",
      "Resource": "arn:aws:s3:::usra-r3-releases"
    }
  ]
}
